# AI Video Automation Platform — Environment Configuration
APP_NAME="AI Video Automation Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database (SQLite async default for local dev; use postgresql+asyncpg://user:pass@localhost:5432/vid_automation in prod)
DATABASE_URL="sqlite+aiosqlite:///./vid_automation.db"
REDIS_URL="redis://localhost:6379/0"

# Storage & Signed URLs
SECRET_KEY="replace-with-secure-secret-key"
SIGNED_URL_TTL_SECONDS=900
STORAGE_DIR="./uploads"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET="vid-automation-private"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_REGION="auto"

# Media Processing Limits
MAX_UPLOAD_BYTES=524288000
MAX_SOURCE_DURATION_SECONDS=1800
WORKER_TEMP_DIR="/tmp/vid_automation_work"
MAX_CONCURRENT_JOBS=2

# AI Speech-to-Text Provider
AI_TRANSCRIPTION_API_KEY=""
AI_TRANSCRIPTION_MODEL="whisper-1"
