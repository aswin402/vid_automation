{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CelestiaVid",
  "version": "0.2.0",
  "identifier": "com.celestialabs.celestiavid",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../apps/web"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../apps/web"
    },
    "frontendDist": "../apps/web/dist",
    "windows": {
      "staticVCRuntime": false
    }
  },
  "app": {
    "windows": [
      {
        "title": "CelestiaVid Studio — AI Video Automation",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Video",
    "shortDescription": "AI Branded Video Automation Studio",
    "longDescription": "Turn raw clips into trimmed, color-graded, noise-cleaned, logo-branded, AI-subtitled MP4 videos locally in pure Rust.",
    "windows": {
      "bundleVCRuntime": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
